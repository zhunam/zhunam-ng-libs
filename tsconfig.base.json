{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@zhunam/data-grid": ["./libs/data-grid/src/index.ts"],
      "@zhunam/form-builder": ["./libs/form-builder/src/index.ts"],
      "@zhunam/auth": ["./libs/auth/src/index.ts"],
      "@zhunam/auth/firebase": ["./libs/auth/firebase/src/index.ts"],
      "@zhunam/auth/supabase": ["./libs/auth/supabase/src/index.ts"],
      "@zhunam/auth/form-ui": ["./libs/auth/form-ui/src/index.ts"],
      "@zhunam/pdf-generator": ["./libs/pdf-generator/src/index.ts"],
      "@zhunam/calendar": ["./libs/calendar/src/index.ts"],
      "@zhunam/calendar/google": ["./libs/calendar/google/src/index.ts"],
      "@zhunam/calendar/calendar-ui": ["./libs/calendar/calendar-ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
